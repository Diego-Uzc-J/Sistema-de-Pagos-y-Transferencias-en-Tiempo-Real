# Copia este archivo a .env y ajusta las credenciales de tu entorno local.
# .env está ignorado por git y no debe versionarse.
POSTGRES_DB=core_banking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Opcionales: solo afectan al servicio `app` de docker-compose (perfil "app").
# APP_PORT=8080
# JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
